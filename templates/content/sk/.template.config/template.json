{
  "$schema": "http://json.schemastore.org/template",
  "author": "Jose Ojeda",
  "classifications": [
    "Creatura",
    "Agent",
    "Console"
  ],
  "identity": "Creatura.Templates.Sk",
  "name": "Creatura on Semantic Kernel",
  "shortName": "creatura-sk",
  "description": "The Creatura control layer on Semantic Kernel: offline until a model key is set, then that model through the OpenAI chat API.",
  "sourceName": "CreaturaApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "creaturaVersion": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "CREATURA_VERSION",
      "defaultValue": "__PACKAGE_VERSION__",
      "description": "The version of the Creatura packages the project references."
    },
    "keyEnv": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "MODEL_KEY_ENV",
      "defaultValue": "OPENAI_API_KEY",
      "description": "The name of the environment variable that holds the model key (the key itself is never written)."
    },
    "baseUrl": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "MODEL_BASE_URL",
      "defaultValue": "https://api.openai.com/v1",
      "description": "The OpenAI-compatible base URL."
    },
    "model": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "MODEL_NAME",
      "defaultValue": "gpt-4.1-mini",
      "description": "The model name."
    }
  }
}
