<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The host brings Semantic Kernel; its OpenAI connector is only for a model in the seat (the seat option). Seats and Worlds bring no package. -->
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.81.0" />
    <ProjectReference Include="../../src/Creatura.Hosts.SemanticKernel/Creatura.Hosts.SemanticKernel.csproj" />
    <ProjectReference Include="../../src/Creatura.Worlds/Creatura.Worlds.csproj" />
    <ProjectReference Include="../../src/Creatura.Seats/Creatura.Seats.csproj" />
  </ItemGroup>
</Project>
