<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The terminal worlds' tests. The four scenarios, the honesty tests and the catalogue tests need nothing: they run
         over the scripted SimulatedTerminal and are offline and deterministic. The one live test ([TerminalFact]) drives
         the real Sentiora runtime and is in the Terminal category (dotnet test's Category filter leaves it out); without
         node or a runtime it is skipped with the reason and the fix. -->
    <ProjectReference Include="..\..\src\Creatura\Creatura.csproj" />
    <ProjectReference Include="..\..\src\Creatura.Worlds.Terminal\Creatura.Worlds.Terminal.csproj" />
  </ItemGroup>

</Project>
