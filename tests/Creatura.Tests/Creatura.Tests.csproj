<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- AXI (#90): validates samples/Axi's lines against Singular's axi/v1 schema, copied as data under axi-contract/. Not a Singular package. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The goldens are recorded in en-US formatting; this pins the tests to it on any machine. -->
    <Compile Include="..\TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Creatura\Creatura.csproj" />
    <ProjectReference Include="..\..\src\Creatura.Worlds\Creatura.Worlds.csproj" />
    <ProjectReference Include="..\..\src\Creatura.Bench\Creatura.Bench.csproj" />
    <ProjectReference Include="..\..\src\Creatura.Seats\Creatura.Seats.csproj" />
    <ProjectReference Include="..\..\src\Creatura.Ratings\Creatura.Ratings.csproj" />
    <!-- creatura rate is tested here beside the ratings it prints. -->
    <ProjectReference Include="..\..\src\Creatura.Cli\Creatura.Cli.csproj" />
    <!-- AXI (#90): the sample is run as a process; the reference builds it and copies it beside the tests. -->
    <ProjectReference Include="..\..\samples\Axi\Axi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="axi-contract\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
