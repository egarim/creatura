{
  // The two-creatures judge as a web world (docs/design-web-worlds.md, "The two-creatures judge as a web world",
  // slice iii): the shopping-list goal as an adapter. The runner fills {{item}} with a fresh item per check ("milk <n>",
  // so repeated checks never see each other's items) and {{restart}} with the deployer's restart on this host, and sets
  // the base url to the app as world publishes it on this host's loopback.
  // Two tasks stand for the five steps of images/judge/test.mjs: add-item (steps 1 to 3: the page loads, the item is in
  // the data after Add, a second browser shows it within 5 s with no reload) and tick-item (steps 4 and 5: ticked in
  // the data, shown ticked in a second browser, and still there and ticked after a restart). The read endpoint is the
  // goal's: GET /api/items answers [{"name": ..., "bought": true|false}, ...].
  "app": "shopping-list",
  "baseUrl": "http://world:8080/",
  "personas": [
    { "id": "judge", "description": "You are the outside test. You do exactly what the script says and nothing else." }
  ],
  "environments": [
    { "id": "desktop", "width": 1280, "height": 800 }
  ],
  "tasks": [
    {
      "id": "add-item",
      "prompt": "Add \"{{item}}\" to the shared shopping list.",
      "start": "/",
      "commits": [ "Add" ],
      "check": { "method": "GET", "url": "/api/items", "path": "", "contains": { "name": "{{item}}" } },
      "live": { "withinMs": 5000, "text": "{{item}}" }
    },
    {
      "id": "tick-item",
      "prompt": "Mark \"{{item}}\" as bought on the shared shopping list.",
      "start": "/",
      "commits": [ "{{item}}" ],
      "check": { "method": "GET", "url": "/api/items", "path": "", "contains": { "name": "{{item}}", "bought": true } },
      "live": { "withinMs": 5000, "text": "{{item}}" },
      "survives": { "restart": { "method": "POST", "url": "{{restart}}" }, "patienceMs": 60000 }
    }
  ],
  "limits": { "steps": 6, "escalations": 0, "stuckPatience": 0, "testers": [] },
  "errorText": [ "Error" ]
}
