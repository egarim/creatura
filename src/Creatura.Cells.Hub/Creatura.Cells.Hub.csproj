<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The ledger hub (docs/design-cells.md, "Slice 4"): SyncFramework's sync controller over a delta store that
       verifies every entry it is sent and numbers deltas from its own SQLite file. Run it on one cell's vessel with
       its listen address (the README has the command line). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Creatura.Cells.Hub</RootNamespace>
    <AssemblyName>Creatura.Cells.Hub</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BIT.Data.Sync.AspNetCore" Version="3.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Creatura.Cells.Sync\Creatura.Cells.Sync.csproj" />
  </ItemGroup>

</Project>
