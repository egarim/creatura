<Project Sdk="Microsoft.NET.Sdk">

  <!-- The work ledger in SQLite (docs/design-cells.md, "Slice 3"). Its own project so Creatura.Cells stays
       package-free: this is the one place the cells take a package. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Creatura.Cells.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Creatura.Cells\Creatura.Cells.csproj" />
  </ItemGroup>

</Project>
