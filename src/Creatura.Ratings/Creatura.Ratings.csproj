<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Creatura.Ratings</RootNamespace>
    <Description>Ratings for Creatura: a Weng-Lin (open TrueSkill-style) rating per seat, model, design or prompt, read from the rows the bench, the web-world matrices and the two-creatures runs already write, with its uncertainty and a leaderboard that says whether more runs would change the order.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ratings (docs/design-ratings.md). Package-free like the Core (CorePurityTest): the rows come through Creatura.Bench's
         own CSV reader, and a matrix's report.json and a pair's summary.json are read with System.Text.Json alone, so no
         browser and no model SDK stand behind a leaderboard. -->
    <ProjectReference Include="../Creatura/Creatura.csproj" />
    <ProjectReference Include="../Creatura.Bench/Creatura.Bench.csproj" />
  </ItemGroup>

</Project>
