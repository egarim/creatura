<Project Sdk="Microsoft.NET.Sdk">

  <!-- The `creatura` command (`creatura cell ...`). No package references of its own (CellsPurityTest): its
       packages come through Creatura.Cells.Sqlite (Microsoft.Data.Sqlite, the sqlite store) and Creatura.Cells.Sync
       (BIT.Data.Sync, cell sync). The assembly is
       Creatura.Cli, not "creatura": on a case-insensitive file system it would collide with Creatura.dll.
       Run it with dotnet run on this project (arguments after a double dash), or pack it as a .NET tool whose
       command is `creatura`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Creatura.Cli</RootNamespace>
    <AssemblyName>Creatura.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>creatura</ToolCommandName>
    <PackageId>Creatura.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The activity stream's page and the icons it shows (StreamPage): embedded, so the page fetches nothing from outside. -->
    <EmbeddedResource Include="stream.html" LogicalName="stream.html" />
    <EmbeddedResource Include="..\..\docs\assets\creatura-icon.svg" LogicalName="icon.svg" Link="icon.svg" />
    <EmbeddedResource Include="..\..\docs\assets\creatura-icon-light.svg" LogicalName="icon-light.svg" Link="icon-light.svg" />
    <!-- The templates creatura new makes projects from: the same files Creatura.Templates packs for dotnet new. -->
    <EmbeddedResource Include="..\..\templates\content\**\*" Exclude="..\..\templates\content\**\bin\**;..\..\templates\content\**\obj\**" LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Creatura\Creatura.csproj" />
    <ProjectReference Include="..\Creatura.Cells\Creatura.Cells.csproj" />
    <ProjectReference Include="..\Creatura.Cells.Sqlite\Creatura.Cells.Sqlite.csproj" />
    <ProjectReference Include="..\Creatura.Cells.Sync\Creatura.Cells.Sync.csproj" />
    <!-- creatura run: the agent and world catalogs, and the seats (the planner, a script or a catalogued model). -->
    <ProjectReference Include="..\Creatura.Worlds\Creatura.Worlds.csproj" />
    <ProjectReference Include="..\Creatura.Seats\Creatura.Seats.csproj" />
  </ItemGroup>

</Project>
