<Project Sdk="Microsoft.NET.Sdk">

  <!-- The work ledger over egarim/SyncFramework (docs/design-cells.md, "Slice 3"). BIT.Data.Sync has no package
       references of its own; 3.0.0 is the first release with the in-memory client and the pull-before-push fix. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Creatura.Cells.Sync</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Creatura.Cells\Creatura.Cells.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BIT.Data.Sync" Version="3.0.0" />
  </ItemGroup>

</Project>
