<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scenarios where several creaturas drive machines in one shared world and coordinate through their cells'
       ledgers over an in-memory mesh (docs/design-machine-vessels.md). No package references. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Creatura.Scenarios</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Creatura\Creatura.csproj" />
    <ProjectReference Include="..\Creatura.Cells\Creatura.Cells.csproj" />
    <ProjectReference Include="..\Creatura.Bench\Creatura.Bench.csproj" />
    <ProjectReference Include="..\Creatura.Seats\Creatura.Seats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The trained networks: arm N's by tools/train/train_policy.py, arm R's by tools/train/train_trial.py
         (docs/design-trained-models.md, steps 2 and 3). -->
    <EmbeddedResource Include="..\..\models\convoy-policy-*.json" LogicalName="Creatura.Scenarios.%(Filename).json" />
    <EmbeddedResource Include="..\..\models\convoy-world-*.json" LogicalName="Creatura.Scenarios.%(Filename).json" />
    <EmbeddedResource Include="..\..\models\convoy-judge-*.json" LogicalName="Creatura.Scenarios.%(Filename).json" />
    <EmbeddedResource Include="..\..\models\convoy-jepa-*.json" LogicalName="Creatura.Scenarios.%(Filename).json" />
  </ItemGroup>

</Project>
